set shell := ["bash", "-euo", "pipefail", "-c"]

workspace := "workspaces/coco-cats"
db := workspace + "/data/dataset.db"

default:
    @just --list

# Create the SQLite store for the workspace
init-db:
    uv run scripts/init_db.py --db {{db}} --task captioning

# Download the COCO cat subset (all, or the first N for trials)
download limit="":
    uv run scripts/download_coco_cats.py --workspace {{workspace}} {{ if limit == "" { "" } else { "--limit " + limit } }}

# Caption N items and print image paths with the four variants for review
trial n="3":
    uv run python -m captioning.pipeline --limit {{n}} --trial

# Caption every pending item
run:
    uv run python -m captioning.pipeline

# Print a 5 % sample (path + captions) for a human second pass
review:
    uv run python -m captioning.pipeline --review

# Export output/captions.jsonl
export:
    uv run scripts/export_captions.py --db {{db}} --out {{workspace}}/output/captions.jsonl

# Refresh the pinned skill copies from the annotools repository
sync-skills:
    for s in annotation-project-interview sqlite-annotation-store agent-vision-tools task-image-captioning mllm-multimodal-input; do rm -rf skills/$s && cp -r ../../skills/$s skills/; done; git -C ../.. rev-parse --short HEAD > skills/PINNED.txt

# Lint, types, tests
check:
    uv run ruff check . && uv run ruff format --check . && uv run ty check && uv run pytest -q
